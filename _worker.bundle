    const rAula = String(rCells[colOffset + 5] ?? "").toUpperCase().trim();
    const rInicio = canon("time", rCells[colOffset + 3]);
    if (rFecha && rAula && rFecha === fechaIso && rAula === aulaUpper && rInicio === inicioNorm) {
      targetRowIdx = r;
      break;
    }
  }
